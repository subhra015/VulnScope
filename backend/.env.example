# VulnScope Backend – Environment Configuration
# Copy this file to .env in the backend directory.
# NEVER commit .env to version control.

# Set to "true" to enable verbose logging and SQL echo
DEBUG=false

# Application metadata
APP_NAME="VulnScope API"
APP_VERSION="0.1.0"

# CORS: Comma-separated list of allowed frontend origins
FRONTEND_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"

# SQLite Database URL
# Default resolves to backend/data/vulnscope.db
DATABASE_URL="sqlite:///./data/vulnscope.db"

# Phase 2: Intake & Workspace Security Limits
WORKSPACES_DIR="./data/workspaces"
MAX_UPLOAD_SIZE_BYTES=52428800
MAX_EXPANDED_SIZE_BYTES=157286400
MAX_FILE_COUNT=2000
MAX_FILE_SIZE_BYTES=26214400
MAX_DIRECTORY_DEPTH=10
MAX_COMPRESSION_RATIO=100.0
GITHUB_CONNECT_TIMEOUT_SECONDS=10.0
GITHUB_READ_TIMEOUT_SECONDS=30.0
MAX_GITHUB_DOWNLOAD_SIZE_BYTES=52428800

# Phase 3: Real Security Scanners Configuration
SEMGREP_BINARY_PATH="semgrep"
GITLEAKS_BINARY_PATH="gitleaks"
OSV_SCANNER_BINARY_PATH="osv-scanner"
SEMGREP_TIMEOUT_SECONDS=120.0
GITLEAKS_TIMEOUT_SECONDS=60.0
OSV_SCANNER_TIMEOUT_SECONDS=90.0
MAX_SCANNER_OUTPUT_BYTES=20971520
MAX_CONCURRENT_SCANS=2
SEMGREP_RULES_CONFIG="p/default"

# Phase 5: AI-Assisted Remediation, Safe Fix Previews, and Reports
# AI Provider: "disabled", "ollama", or "openai"
AI_PROVIDER="disabled"
# Base URL for AI provider.
# For Ollama: "http://localhost:11434" (must be loopback)
# For OpenAI: "https://api.openai.com/v1" (must be HTTPS)
AI_BASE_URL="http://localhost:11434"
# Model identifier (e.g. "llama3", "codellama", "gpt-4o-mini")
AI_MODEL="llama3"
# API Key for remote provider (NEVER commit real keys)
AI_API_KEY=""
AI_TIMEOUT_SECONDS=30.0
AI_MAX_OUTPUT_TOKENS=2000
AI_MAX_RETRIES=1
# Enforce explicit user opt-in before sending snippets to remote AI providers
AI_REMOTE_OPT_IN_REQUIRED=true
AI_MAX_SNIPPET_LINES=20
AI_MAX_SNIPPET_BYTES=4096
