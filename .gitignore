# VulnScope .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/

# Node & Frontend
node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.cache/
frontend/.oxlintrc.json
*.tsbuildinfo
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Databases
backend/data/*.db
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm

# Environment & Secrets (NEVER commit secrets or real env files)
.env
.env.local
.env.*.local
frontend/.env
backend/.env

# Temporary scan artifacts (for future phases)
backend/data/workspaces/
temp/
tmp/
uploads/
scans_temp/
reports/

# Operating System & IDE
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
